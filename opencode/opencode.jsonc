{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff": "allow",
      "git log": "allow",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny"
    },
    "edit": "allow",
    "external_directory": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "skill": "allow",
    "task": "allow"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["bash", "-c", "exec \"$HOME/.config/opencode/excellence-ops/playwright-launch.sh\""],
      "enabled": true
    }
  }
}
