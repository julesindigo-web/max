{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-improvement-requests.schema.json",
  "title": "Skill Improvement Evaluation Requests v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "processing_summary", "decisions", "requests", "safety_note"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "audit_id": {"type": "string", "minLength": 1},
    "processing_summary": {
      "type": "object",
      "required": ["findings_seen", "eligible_findings", "requests_generated", "findings_not_triggered"],
      "properties": {
        "findings_seen": {"type": "integer", "minimum": 0},
        "eligible_findings": {"type": "integer", "minimum": 0},
        "requests_generated": {"type": "integer", "minimum": 0},
        "findings_not_triggered": {"type": "integer", "minimum": 0}
      }
    },
    "decisions": {"type": "array", "items": {"type": "object"}},
    "safety_note": {"type": "string", "minLength": 1},
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["request_id", "target_skill", "source_finding_id", "priority", "requires_human_approval", "do_not_modify_skill_automatically", "requested_evaluation"],
        "properties": {
          "request_id": {"type": "string"},
          "target_skill": {"enum": ["project-artifact-auditor", "skills-create-excellence"]},
          "source_finding_id": {"type": "string"},
          "priority": {"enum": ["P1", "P2", "P3", "P4"]},
          "requires_human_approval": {"const": true},
          "do_not_modify_skill_automatically": {"const": true},
          "requested_evaluation": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
