{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-set-manifest.schema.json",
  "title": "Skill Set Manifest Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "purpose", "last-reviewed", "success-metrics", "members", "composition-rules", "shared-contracts", "validation-entry", "deprecation-policy", "migration-notes"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "purpose": {"type": "string", "minLength": 1},
    "last-reviewed": {"type": "string", "format": "date"},
    "success-metrics": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}},
    "members": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "version", "path", "depends-on", "provides"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"},
          "depends-on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "provides": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "composition-rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "shared-contracts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validation-entry": {"type": "string", "minLength": 1},
    "deprecation-policy": {"type": "string", "minLength": 1},
    "migration-notes": {"type": "string"}
  }
}
